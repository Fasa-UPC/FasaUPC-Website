<form id="edit-team-form" class="grid gap-2 grid-cols-1 lg:grid-cols-2">
    <div class="input-wrapper">
        <label class="label">
            عنوان
        </label>
        <input class="input" value="<%= team.title %>" />
    </div>

    <div class="input-wrapper row-start-2 col-span-full">
        <label class="label">
            توضیحات
        </label>
        <textarea class="input" rows="3"><%= team.description %></textarea>
    </div>

    <button type="submit" class="btn primary col-span-full md:justify-self-end mt-8">ویرایش</button>
</form>

<!-- #region Members section -->
<div class="mt-16">
    <% if (team.users.length> 0) { %>
        <div class="text-end">
            <button class="btn outlined add-member-btn">افزودن عضو</button>
        </div>
        <% } %>
            <div class="overflow-x-auto">
                <% if (team.users.length> 0) { %>
                    <table class="datagrid" id="teams-table">
                        <thead>
                            <tr>
                                <!-- No. -->
                                <th class="grow-0 max-w-[50px] w-[50px]"></th>

                                <!-- Name -->
                                <th class="grow shrink-0 min-w-[150px] w-[150px]">نام</th>

                                <!-- Surname -->
                                <th class="grow shrink-0 min-w-[150px] w-[150px]">نام خانوادگی</th>

                                <!-- Title -->
                                <th class="grow shrink-0 min-w-[200px] w-[200px]">عنوان</th>

                                <!-- Actions -->
                                <th class="grow-0 shrink-0 max-w-[50px] w-[50px]"></th>
                            </tr>
                        </thead>

                        <tbody>
                            <% team.users.forEach((user, index)=> { %>
                                <tr>
                                    <!-- No. -->
                                    <td class="grow-0 max-w-[50px] w-[50px]">
                                        <%= index + 1 %>
                                    </td>

                                    <!-- Name -->
                                    <td class="grow shrink-0 min-w-[150px] w-[150px]">
                                        <%= user.user.profile.firstName %>
                                    </td>

                                    <!-- Surname -->
                                    <td class="grow shrink-0 min-w-[150px] w-[150px]">
                                        <%= user.user.profile.lastName %>
                                    </td>

                                    <!-- Title -->
                                    <td class="grow shrink-0 min-w-[200px] w-[200px]">
                                        <%= user.user.profile.title %>
                                    </td>

                                    <!-- Actions -->
                                    <td class="grow-0 shrink-0 max-w-[50px] w-[50px]">
                                        <button class="actions-btn" data-id="<%= user.id %>">...</button>
                                        <div class="dropdown" data-id="<%= user.id %>">
                                            <button class="dropdown-item edit">جزییات و ویرایش</button>
                                            <button class="dropdown-item delete">حذف</button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                    <% } else { %>
                        <div
                            class="h-[200px] w-full rounded-2xl border-2 border-dark-100/25 flex flex-col gap-4 justify-center items-center">
                            <p class="text-dark-100">عضوی برای تیم انتخاب نکرده اید!</p>
                            <button class="btn outlined add-member-btn">افزودن عضو</button>
                        </div>
                        <% } %>
            </div>
</div>
<!-- #endregion -->

<!-- #region Add memeber modal -->
<div id="add-member-modal" class="modal">
    <div
        class="content px-2 py-4 rounded-xl w-screen h-screen flex flex-col md:h-[600px] md:max-h-screen md:w-[600px] lg:w-[800px]">
        <div class="text-lg font-bold text-dark-50 mb-4">
            افزودن عضو
        </div>
        <div class="flex w-full gap-2">
            <input class="input grow" id="user-search-input" placeholder="جستوجوی کاربر" />
            <button class="btn outlined border" id="user-search-btn">جستوجو</button>
        </div>
        <!-- #region Users list -->
        <div class="h-fit overflow-y-auto grow" id="users-list-modal">
        </div>
        <!-- #region -->
        <div class="flex gap-2 w-full bg-dark600">
            <!-- <button class="btn primary w-full">بله</button> -->
            <button class="btn outlined w-full close-btn" data-for="add-member-modal">بستن</button>
        </div>
    </div>
    <div class="overlay"></div>
</div>
<!-- #endregion -->

<!-- #region Edit team modal -->
<div id="edit-team-confirm" class="modal">
    <div class="content px-2 py-4 rounded-xl w-[80%] md:w-[400px]">
        <div class="text-dark-50">
            آیا از ویرایش اطلاعات این تیم مطمئن هستید؟
        </div>
        <div class="flex gap-2 mt-6">
            <button class="btn primary w-full" id="confirm-btn">بله</button>
            <button class="btn outlined w-full close-btn" data-for="edit-team-confirm">انصراف</button>
        </div>
    </div>
    <div class="overlay"></div>
</div>
<!-- #endregion -->

<template id="user-card-temp">
    <div class="user-card border-b transition-all border-dark-50/25 px-2 py-4 group" data-id="">
        <div class="flex justify-between items-center">
            <div class="flex gap-4 items-center">
                <img src="" alt="" class="w-[64px] h-[64px] rounded-lg bg-dark-100" />
                <div class="flex flex-col gap-2">
                    <p class="user-fullname text-dark-50"></p>
                    <p class="user-title text-sm text-dark-100"></p>
                </div>
            </div>

            <button class="add-btn hidden group-[.default]:block btn primary">افزودن</button>
            <button class="remove-btn hidden group-[.member]:block btn outlined">حذف از تیم</button>
        </div>
    </div>
</template>

<script src="/scripts/vendors/popper.min.js"></script>
<script src="/scripts/vendors/tippy-bundle.umd.min.js"></script>
<script src="/scripts/modal.js"></script>

<script>
    const actionsBtns = Array.from(document.getElementsByClassName('actions-btn'));

    actionsBtns.forEach(ab => {
        const id = ab.dataset.id;
        const dropdown = document.querySelector(`.dropdown[data-id="${id}"]`);

        tippy(ab, {
            content: dropdown,
            trigger: 'click',
            placement: 'bottom',
            appendTo: 'parent',
            arrow: false,
            interactive: true,
            onShown(instance) {
                const dropdownItems = Array.from(instance.popper.querySelectorAll('.dropdown-item'));
                dropdownItems.forEach(di => {
                    di.addEventListener("click", () => {
                        instance.hide();
                    })
                })
            }
        });
    })
</script>

<script>
    const editTeamForm = document.getElementById('edit-team-form');
    const editTeamConfirmModal = document.getElementById('edit-team-confirm');

    function openEditTeamConfirmModal() {
        editTeamConfirmModal.classList.add("show");
    }

    function submitEditTeamForm(ev) {
        ev.preventDefault();

        openEditTeamConfirmModal();
    }

    editTeamForm.addEventListener('submit', submitEditTeamForm);
</script>

<script>
    const addMemberBtns = Array.from(document.querySelectorAll(".add-member-btn"));
    const addMemberModal = document.getElementById("add-member-modal");
    const userSearchInput = document.getElementById("user-search-input");
    const userSearchBtn = document.getElementById("user-search-btn");
    const usersListModal = document.getElementById("users-list-modal");
    const userCardTemp = document.getElementById("user-card-temp");

    // #region Modal open
    function openAddMemberModal(ev) {
        ev.stopPropagation();
        addMemberModal.classList.add("show");
    }

    addMemberBtns.forEach(btn => {
        btn.addEventListener("click", openAddMemberModal);
    });
    // #endregion

    // #region User search
    async function searchUser(search) {
        const userCountRes = await fetch(`http://localhost:4000/panel/users/search/count?search=${search}`, {
            method: "GET",
        });

        const { count: usersCount } = await userCountRes.json();

        if (usersCount > 0) {
            const usersRes = await fetch(`http://localhost:4000/panel/users/search?search=${search}&teamID=<%= team.id %>`, {
                method: "GET"
            });

            const users = await usersRes.json();

            return { users, usersCount }
        }
        return { users: [], usersCount }
    }

    async function userSearchBtnHandler() {
        const searchStr = userSearchInput.value;

        const { users, usersCount } = await searchUser(searchStr);

        renderUsersListModal(users);
    }

    function renderUsersListModal(users) {
        usersListModal.replaceChildren();
        users.forEach((user, index) => {
            const userCardClone = userCardTemp.content.cloneNode(true);
            const userCard = userCardClone.querySelector(".user-card");
            const usernameElem = userCardClone.querySelector(".user-fullname");
            const userTitleElem = userCardClone.querySelector(".user-title");
            const addBtn = userCardClone.querySelector(".add-btn");
            const removeBtn = userCardClone.querySelector(".remove-btn");

            userCard.classList.add(user.teams?.length ? "member" : "default");
            usernameElem.textContent = `${user.profile.firstName} ${user.profile.lastName}`;
            userTitleElem.textContent = user.profile.title || "تعیین نشده";
            userCard.dataset.id = user.id;
            addBtn.addEventListener('click', () => {
                addToTeam(user.id);
            })
            removeBtn.addEventListener('click', () => {
                removeFromTeam(user.id);
            })

            usersListModal.appendChild(userCardClone);
        })
    }

    async function addToTeam(userID) {
        const teamID = "<%= team.id %>";
        try {
            const res = await fetch(`http://localhost:4000/panel/teams/${teamID}/members`, {
                method: "POST",
                body: JSON.stringify({
                    userID
                }),
                headers: {
                    "Content-Type": "application/json",
                },
            });

            if (res.ok) {
                const userCard = document.querySelector(`.user-card[data-id="${userID}"]`);

                if (userCard) {
                    userCard.classList.remove("default");
                    userCard.classList.add("member");
                }
            }
        } catch (err) {
            console.log(err);
        }
    }

    async function removeFromTeam(userID) {
        const teamID = "<%= team.id %>";
        try {
            const res = await fetch(`http://localhost:4000/panel/teams/${teamID}/members`, {
                method: "DELETE",
                body: JSON.stringify({
                    userID
                }),
                headers: {
                    "Content-Type": "application/json",
                },
            });

            if (res.ok) {
                const userCard = document.querySelector(`.user-card[data-id="${userID}"]`);

                if (userCard) {
                    userCard.classList.add("default");
                    userCard.classList.remove("member");
                }
            }
        } catch (err) {
            console.log(err);
        }
    }

    userSearchBtn.addEventListener("click", userSearchBtnHandler);
    // #endregion
</script>