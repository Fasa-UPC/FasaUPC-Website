<!-- Datagrid btns -->
<div class="flex justify-end mb-2">
    <button class="btn primary" id="new-team-btn">
        جدید
    </button>
</div>
<!-- Datagrid -->
<div class="overflow-x-auto">
    <table class="datagrid" id="teams-table">
        <thead>
            <tr>
                <!-- No. -->
                <th class="grow-0 max-w-[50px] w-[50px]"></th>

                <!-- Title -->
                <th class="grow shrink min-w-[200px] w-[200px]">عنوان</th>

                <!-- Projects -->
                <th class="grow shrink min-w-[100px] w-[100px]">تعداد پروژه ها</th>

                <!-- Colaborators-Count -->
                <th class="grow shrink-0 min-w-[100px] w-[100px]">تعداد اعضا</th>

                <!-- Actions -->
                <th class="grow-0 shrink-0 max-w-[50px] w-[50px]"></th>
            </tr>
        </thead>

        <tbody>
            <% teams.forEach((team, index)=> { %>
                <tr>
                    <!-- No. -->
                    <td class="grow-0 max-w-[50px] w-[50px]">
                        <%= offset + index + 1 %>
                    </td>

                    <!-- Title -->
                    <td class="grow shrink min-w-[200px] w-[200px]">
                        <%= team.title %>
                    </td>

                    <!-- Projects -->
                    <td class="grow shrink-0 min-w-[100px] w-[100px]">
                        <%= team.projectsCount %>
                    </td>

                    <!-- Colaborators-Count -->
                    <td class="grow shrink-0 min-w-[100px] w-[100px]">
                        <%= team.usersCount %>
                    </td>

                    <!-- Actions -->
                    <td class="grow-0 shrink-0 max-w-[50px] w-[50px]">
                        <button class="actions-btn" data-id="<%= team.id %>">...</button>
                        <div class="dropdown" data-id="<%= team.id %>">
                            <button class="dropdown-item edit">جزییات و ویرایش</button>
                            <button class="dropdown-item delete">حذف</button>
                        </div>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>
</div>

<script>
    const addNewTeamBtn = document.getElementById('new-team-btn');

    function navigateToNewTeamPage() {
        window.location.assign("/panel/teams/new");
    }

    addNewTeamBtn.addEventListener("click", navigateToNewTeamPage);
</script>

<script src="/scripts/vendors/popper.min.js"></script>
<script src="/scripts/vendors/tippy-bundle.umd.min.js"></script>

<script>
    const dropdowns = Array.from(document.querySelectorAll('.dropdown'));

    dropdowns.forEach(d => {
        const editBtn = d.querySelector('.edit');
        const deleteBtn = d.querySelector('.delete');
        const id = d.dataset.id;

        // Handler for edit 
        editBtn.addEventListener("click", () => {
            window.location.assign(`/panel/teams/${id}/edit`);
        });

        // Handler for delete
        deleteBtn.addEventListener("click", () => {
            console.log("delete: ", id);
        });
    });
</script>

<script>
    const actionsBtns = Array.from(document.getElementsByClassName('actions-btn'));

    actionsBtns.forEach(ab => {
        const id = ab.dataset.id;
        const dropdown = document.querySelector(`.dropdown[data-id="${id}"]`);

        tippy(ab, {
            content: dropdown,
            trigger: 'click',
            placement: 'bottom',
            appendTo: 'parent',
            arrow: false,
            interactive: true,
            onShown(instance) {
                const dropdownItems = Array.from(instance.popper.querySelectorAll('.dropdown-item'));
                dropdownItems.forEach(di => {
                    di.addEventListener("click", () => {
                        instance.hide();
                    })
                })
            }
        });
    })
</script>